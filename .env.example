# Copy this file to .env and fill in real values. Never commit .env.
# See FINALSTEPS.md for exactly where to get each of these.

# --- Kaggle (for downloading the Spotify Tracks Dataset via kagglehub) ---
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# --- Spotify Web API (for OAuth + creating real playlists via spotipy) ---
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Optional overrides ---
# Directory for raw/processed data (defaults to ./data)
MUSIC_AGENT_DATA_DIR=./data
# Directory for training outputs/checkpoints (defaults to ./outputs)
MUSIC_AGENT_OUTPUT_DIR=./outputs
